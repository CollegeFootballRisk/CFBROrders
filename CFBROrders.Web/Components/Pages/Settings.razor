@page "/settings"
@inject IAppSettingHandler AppSettingsHandler

<title>Settings - College Football Risk</title>

<h1 class="text-center">Settings</h1>

    <div class="main">

        <div class="d-flex align-items-center">
            <RadzenSwitch Value="AppSettingsHandler.LightMode"
                          ValueChanged="AppSettingsHandler.SetLightModeAsync"
                          Class="setting-control" />
            <span>Light Mode</span>
        </div>

        <div class="d-flex align-items-center">
            <RadzenDropDown Value="AppSettingsHandler.Branding"
                            ValueChanged="@(async (string val) => await AppSettingsHandler.SetBrandingAsync(val))"
                            Data="@BrandingOptions"
                            Class="rz-dropdown-pill setting-control" />
            <span>Branding</span>
        </div>

        <div class="d-flex align-items-center">
            <RadzenDropDown Value="AppSettingsHandler.SeasonalBackground"
                            ValueChanged="@(async (string val) => await AppSettingsHandler.SetSeasonalBackgroundAsync(val))"
                            Data="@SeasonalOptions"
                            Class="rz-dropdown-pill setting-control" />
            <span>Seasonal Background</span>
        </div>

        <hr />

    </div>

@code {
    private static readonly string[] BrandingOptions =
        ["Normal - Rainbow", "Goose", "Pizza", "Classic", "Normal - White"];

    private static readonly string[] SeasonalOptions =
        ["None", "Valentines", "Spring", "Summer", "Fall", "Halloween", "Thanksgiving", "Winter"];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AppSettingsHandler.InitializeAsync();
        }
    }
}



